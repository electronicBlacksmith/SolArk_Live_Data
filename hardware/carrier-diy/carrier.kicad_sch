	(text
		"POWER: harness 12 V -> F1 PPTC -> D1 reverse-polarity -> TVS1/C1/C2 -> U2 buck -> D2 backfeed block -> C3/C4 -> XIAO 5V"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "06555aa5-1693-57f3-9cbc-3e3df6bb240d")
	)
	(text
		"TAPS (RECEIVE ONLY): pad -> off-board 10k -> J1 -> R3/R4 1k -> U3 Schmitt buffer inputs -> R7/R8 1k -> XIAO D0/D1."
		(exclude_from_sim no)
		(at 25.4 116.84 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "01fada02-a146-5516-8368-cfba2fda4040")
	)
	(text
		"U3 is a one-way barrier: no XIAO pin has a DC path to a tap line. R5/R6 100k bias the buffer inputs high (UART idle) when J1 is off."
		(exclude_from_sim no)
		(at 25.4 121.92 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "55b3e611-1455-5d98-8dd2-bb27d34ba6d6")
	)
	(text
		"DNP: proxy only. R12 + JP1 (open) + TP1 reserve a future GPIO8 TX path; TP1 is NOT wired to J1."
		(exclude_from_sim no)
		(at 269.24 139.7 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "d7789bbf-a682-53b5-b150-3ae03b317d48")
	)
	(text
		"Fitting R12 and bridging JP1 requires an explicitly approved proxy-mode change."
		(exclude_from_sim no)
		(at 269.24 144.78 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "e658a149-be93-5ed7-8c63-efcec3a328cd")
	)
	(text
		"J1 OFF FOR USB: unplug the harness before connecting a plain USB cable (XIAO 5V is fed from the inverter through D2)."
		(exclude_from_sim no)
		(at 25.4 228.6 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "0a36b5e2-e9c4-5c2a-a2ba-561aca1d8dc4")
	)
	(text
		"J1 wire pads: 1 +12V, 2 GND (power), 3 spare (NC), 4 GND (signal), 5 TAP pad 9 (inverter replies), 6 TAP pad 10 (dongle requests)."
